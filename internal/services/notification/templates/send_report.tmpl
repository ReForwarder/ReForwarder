{{ define "content" }}
<h2 style="color: #111827; font-size: 20px; line-height: 1.3; margin: 0 0 18px; font-weight: 700; letter-spacing: -0.01em;">Daily send report</h2>
<p style="margin: 0 0 16px;">Here is how your workspace's sending performed on {{ .WindowStart }} (UTC):</p>

<table class="stats-table" role="presentation" style="width: 100%; border-collapse: separate; border-spacing: 0; margin: 20px 0; border: 1px solid #eceef2; border-radius: 10px; overflow: hidden;">
  <tr>
    <th style="padding: 12px 16px; text-align: left; border-bottom: 1px solid #eceef2; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; background-color: #f9fafb; color: #6b7280; font-weight: 600;">Outcome (24h)</th>
    <th style="padding: 12px 16px; text-align: right; border-bottom: 1px solid #eceef2; font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; background-color: #f9fafb; color: #6b7280; font-weight: 600;">Count</th>
  </tr>
  <tr>
    <td style="padding: 12px 16px; border-bottom: 1px solid #eceef2; font-size: 14px; color: #111827;">Sent</td>
    <td style="padding: 12px 16px; border-bottom: 1px solid #eceef2; font-size: 14px; text-align: right; color: #111827;">{{ .Sent }}</td>
  </tr>
  <tr>
    <td style="padding: 12px 16px; border-bottom: 1px solid #eceef2; font-size: 14px; color: #111827;">Failed</td>
    <td style="padding: 12px 16px; border-bottom: 1px solid #eceef2; font-size: 14px; text-align: right; color: #111827;">{{ .Failed }}</td>
  </tr>
  <tr>
    <td style="padding: 12px 16px; border-bottom: 1px solid #eceef2; font-size: 14px; color: #111827;">Bounced</td>
    <td style="padding: 12px 16px; border-bottom: 1px solid #eceef2; font-size: 14px; text-align: right; color: #dc2626; font-weight: 600;">{{ .Bounced }}</td>
  </tr>
  <tr>
    <td style="padding: 12px 16px; border-bottom: 1px solid #eceef2; font-size: 14px; color: #111827;">Opened</td>
    <td style="padding: 12px 16px; border-bottom: 1px solid #eceef2; font-size: 14px; text-align: right; color: #111827;">{{ .Opened }}</td>
  </tr>
  <tr>
    <td style="padding: 12px 16px; font-size: 14px; color: #111827;">Clicked</td>
    <td style="padding: 12px 16px; font-size: 14px; text-align: right; color: #111827;">{{ .Clicked }}</td>
  </tr>
</table>

<p style="margin: 16px 0 0; font-size: 13px; color: #6b7280;">{{ .TotalEvents }} timeline events in total for this window.</p>
{{ end }}
